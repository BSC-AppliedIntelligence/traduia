FROM python:3.10-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
ARG TORCH_PACKAGE=torch
ARG TORCHAUDIO_PACKAGE=torchaudio
ARG CTRANSLATE2_PACKAGE=ctranslate2
ARG NUMPY_PACKAGE=numpy<2

# Install basic audio/runtime deps used by the WhisperLive server.
RUN apt-get update && apt-get install -y --no-install-recommends \
    portaudio19-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Keep pip/newer packaging behavior consistent with the generic image path.
RUN pip install --no-cache-dir -U "pip>=24"

WORKDIR /app

# Install a CUDA-enabled PyTorch stack explicitly for Spark before the generic
# server requirements. The build fails fast if pip resolves to a CPU-only wheel.
RUN pip install --no-cache-dir \
    --index-url "${PYTORCH_INDEX_URL}" \
    "${TORCH_PACKAGE}" \
    "${TORCHAUDIO_PACKAGE}"

RUN python -c "import torch; print('torch', torch.__version__); print('torch cuda', torch.version.cuda); assert torch.version.cuda is not None, 'Expected a CUDA-enabled torch wheel, got CPU-only torch'"

# Install the rest of the server dependencies without modifying server.txt.
COPY requirements/server.txt /app/
RUN pip install --no-cache-dir -r server.txt && rm server.txt

# Reinstall ctranslate2 explicitly so the Spark image does not depend on the
# transitive wheel selected by faster-whisper during the generic requirements
# install. This keeps the packaging override local to the Spark build path.
RUN pip install --no-cache-dir --force-reinstall "${CTRANSLATE2_PACKAGE}"

# Some binary dependencies in this stack, notably onnxruntime 1.17.x, still
# require NumPy 1.x ABI compatibility.
RUN pip install --no-cache-dir --force-reinstall "${NUMPY_PACKAGE}"

# Re-check after the generic requirements install in case a dependency path
# replaced torch with a CPU-only build.
RUN python -c "import torch; print('final torch', torch.__version__); print('final torch cuda', torch.version.cuda); assert torch.version.cuda is not None, 'server.txt installation replaced torch with a CPU-only build'"

RUN python -c "import ctranslate2; print('ctranslate2', ctranslate2.__version__)"
RUN python -c "import numpy; import onnxruntime; print('numpy', numpy.__version__); print('onnxruntime', onnxruntime.__version__)"

# Make NVIDIA wheel-provided libraries visible at runtime.
ENV LD_LIBRARY_PATH="/usr/local/lib/python3.10/site-packages/nvidia/cublas/lib:/usr/local/lib/python3.10/site-packages/nvidia/cudnn/lib:/usr/local/lib/python3.10/site-packages/nvidia/cusolver/lib:/usr/local/lib/python3.10/site-packages/nvidia/cusparse/lib:/usr/local/lib/python3.10/site-packages/nvidia/cuda_runtime/lib"
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

COPY whisper_live /app/whisper_live
COPY run_server.py /app

CMD ["python", "run_server.py"]
