# Variables of swarm/stack.yml. Set them in the Portainer stack environment (or export them before `docker stack deploy`);
# `swarm/scripts/init-env.py` can generate this file with fresh secrets. Never commit populated copies. Names only here.

# --- deployment-specific (always required)
TRADUIA_DOMAIN=            # base domain, e.g. example.org: hosts are <domain>, backstage.<domain>, stage.<domain>, livekit.<domain>, turn.<domain>, supabase.<domain>
TRADUIA_PUBLIC_IP=         # public IPv4 of the swarm node (advertised by LiveKit)
TRADUIA_NODE=              # swarm node hostname the tasks are pinned to (GPU + data host)
FORWARDED_ALLOW_IPS=       # source subnet of the Traefik proxy on traefik-public, e.g. 10.0.6.0/24 (docker network inspect traefik-public)
# optional, defaults shown
# TRADUIA_DATA_DIR=/data/traduia
# TRAEFIK_CERT_RESOLVER=le
# LIVEKIT_GWBRIDGE_CIDR=172.18.0.0/16   # subnet of docker_gwbridge

# --- images (optional): the defaults in stack.yml are the reference images on ghcr.io; set these to use your own builds
# BSC_BACKSTAGE_IMAGE=
# BSC_STAGE_IMAGE=
# WHISPERLIVE_IMAGE=
# BSC_MODELSKIT_IMAGE=
# LIVEKIT_IMAGE=

# --- LiveKit (any random key name + secret of at least 32 characters)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Supabase, used by the application (always required)
SUPABASE_URL=              # built-in Supabase: https://supabase.<TRADUIA_DOMAIN>; an existing instance: its URL
SUPABASE_ANON_KEY=         # built-in: generated by scripts/generate-supabase-secrets.py; existing: from its dashboard / API settings
SUPABASE_SERVICE_KEY=      # idem (the service_role key)

# --- built-in Supabase only (not needed if you removed the supabase-* services from stack.yml)
POSTGRES_PASSWORD=
JWT_SECRET=
# SUPABASE_INIT_IMAGE=     # optional: your own build of backstage/db (default: the reference db-init image)
ADMIN_EMAILS=              # optional, comma-separated: these sign-ups become approved administrators

# --- optional text-to-speech (needs a Google credentials file that this stack does not provision)
# TTS_PROVIDER=google_regular
# TTS_VOICE=
