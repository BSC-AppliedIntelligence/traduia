# ===========================================
# Link3rs - BSC Backstage Configuration
# ===========================================

# ===========================================
# Supabase (Required for public API and database)
# Get from: https://supabase.com/dashboard
# Project Settings → API
# ===========================================
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUxxxx._Wxxxxw
SUPABASE_SERVICE_KEY=eyJhbGciOxxx.Yxxxx

# ===========================================
# App URL (IMPORTANT for production deployment)
# Set this to your production domain so Supabase
# email redirects (signup confirmation, password reset)
# point to the correct URL instead of localhost.
# ===========================================
APP_URL=https://backstage.example.org

# ===========================================
# Configuración del Traductor en Tiempo Real
# ===========================================

# ===========================================
# LiveKit (para integración con rooms)
# ===========================================
# URL pública de LiveKit: se devuelve a los navegadores y se guarda en Supabase.
# Cloud: wss://your-project.livekit.cloud
# BSC self-hosted directo: ws://<Spark-address>:7880
LIVEKIT_URL=wss://your-project.livekit.cloud

# URL interna para las conexiones API y de sala de Backstage. Dejar sin definir
# para usar LIVEKIT_URL (LiveKit Cloud o Backstage ejecutado fuera de Docker).
# En el Compose BSC self-hosted: ws://livekit:7880
# LIVEKIT_INTERNAL_URL=ws://livekit:7880

LIVEKIT_API_KEY=APIhxxxxxxxxx
LIVEKIT_API_SECRET=erSiE1xxxxxxxx


# ===========================================
# TTS (Text-to-Speech)
# ===========================================

# TTS Provider: "google_chirp" (recomendado) o "google_regular"
# - google_chirp: Voces Chirp 3 HD de alta calidad (30 voces)
# - google_regular: Google TTS estándar (WaveNet/Neural2)
TTS_PROVIDER=google_chirp

# Ruta al archivo JSON de credenciales de Google Cloud
# Local: ruta a tu archivo JSON descargado de Google Cloud
# Producción (Docker): /app/google-credentials.json (montado via docker-compose)
GOOGLE_APPLICATION_CREDENTIALS=./GoogleCloudKey1.json


# Voz TTS (solo para google_chirp)
# Voces femeninas: Achernar, Aoede, Autonoe, Callirrhoe, Despina, Erinome, 
#                  Gacrux, Kore, Laomedeia, Leda, Pulcherrima, Sulafat, 
#                  Vindemiatrix, Zephyr
# Voces masculinas: Achird, Algenib, Algieba, Alnilam, Charon, Enceladus, 
#                   Fenrir, Iapetus, Orus, Puck, Rasalgethi, Sadachbia, 
#                   Sadaltager, Schedar, Umbriel, Zubenelgenubi
TTS_VOICE=Charon